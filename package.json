{
  "name": "video-dedup-app",
  "productName": "视频去重工具",
  "version": "1.0.0",
  "description": "基于 FFmpeg 的视频去重桌面工具（Electron + React + TypeScript）",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Caldalis",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --project core",
    "test:e2e": "electron-vite build && vitest run --project e2e",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.48.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
